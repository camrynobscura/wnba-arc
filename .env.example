# Base URL of the wnba-data read API.
#
# Local dev: leave it UNSET (no .env needed). The Vite dev server proxies `/api` to the API
# on localhost:3001 (see vite.config.ts), so the app also works from a phone on the same
# wifi. Pointing this at an absolute localhost URL would break that.
#
# Production: set it in your host's environment (e.g. Netlify) to the deployed API URL:
# VITE_API_BASE=https://your-api.example.com
